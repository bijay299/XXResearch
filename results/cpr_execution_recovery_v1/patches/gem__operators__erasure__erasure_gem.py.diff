+# [cpr_execution_recovery_v1 P1c] the ORIGINAL native distance/ReLU expressions, moved verbatim into a module-level function so that
+# a read-only probe can evaluate the very same source on cloned operands. Returns the per-sample vector; the caller
+# applies `.sum()` exactly as the pinned code does.
+def _cpr_native_loss_block(pred_flat, pos_flat, neg_flat, eta):
+    dist_pos = torch.nn.functional.pairwise_distance(pred_flat, pos_flat, p=2)
+    dist_neg = torch.nn.functional.pairwise_distance(pred_flat, neg_flat, p=2)
+    return torch.relu(dist_pos - eta * dist_neg)
 
 
