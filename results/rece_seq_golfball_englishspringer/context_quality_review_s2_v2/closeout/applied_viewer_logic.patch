+// Export files contain response rows; live UI state uses a neutral-ID map.
+function restoreExport(payload) {
+  if (payload.packageVersion !== PACKAGE_VERSION || payload.protocolVersion !== PROTOCOL_VERSION)
+    throw new Error("Wrong package or protocol version");
+  if (!Array.isArray(payload.responses) || payload.responses.length !== PAIRS.length)
+    throw new Error("Expected one response row per pair");
+  const next = freshState();
+  const expected = new Set(PAIRS.map(p => p.id));
+  const seen = new Set();
+  for (const row of payload.responses) {
+    if (!expected.has(row.neutral_id) || seen.has(row.neutral_id))
+      throw new Error("Missing, unknown, or duplicate neutral ID");
+    seen.add(row.neutral_id);
+    const target = next.responses[row.neutral_id];
+    for (const field of Object.keys(target)) {
+      if (typeof row[field] !== "string") throw new Error("Invalid answer field");
+      let allowed = null;
+      if (field.endsWith("_breakdown") || field.endsWith("_local_defects")) allowed = ["", ...YNU.map(x => x[0])];
+      else if (field.endsWith("_style_mismatch")) allowed = ["", ...STYLE_YNU.map(x => x[0])];
+      else if (field === "pair_preference") allowed = ["", ...PAIR_PREF.map(x => x[0])];
+      if (allowed && !allowed.includes(row[field])) throw new Error("Invalid answer value");
+      target[field] = row[field];
+    }
+  }
+  const reviewer = payload.reviewer;
+  if (!reviewer || typeof reviewer.alias !== "string" || typeof reviewer.ack !== "boolean" ||
+      !["", ...EXPOSURE_OPTIONS.map(x => x[0])].includes(reviewer.exposure) ||
+      !["", ...CASE_SPECIFIC_FEEDBACK_OPTIONS.map(x => x[0])].includes(reviewer.caseSpecificFeedback))
+    throw new Error("Invalid reviewer fields");
+  next.reviewer = { alias: reviewer.alias, exposure: reviewer.exposure,
+    caseSpecificFeedback: reviewer.caseSpecificFeedback, ack: reviewer.ack };
+  for (const key of ["startedAt", "exportedAt"]) {
+    if (payload[key] !== null && typeof payload[key] !== "string") throw new Error("Invalid timestamp");
+    next[key] = payload[key];
+  }
+  // Return to reviewer info; the normal Begin action resumes at a defined pair.
+  next.currentIndex = 0;
+  next.setupComplete = false;
+  return next;
+}
+
+function saveReasonAndRefresh(pairId, field, element) {
+  const id = element.id;
+  const start = element.selectionStart;
+  const end = element.selectionEnd;
+  const x = window.scrollX, y = window.scrollY;
+  state.responses[pairId][field] = element.value;
+  saveState();
+  render();
+  const replacement = document.getElementById(id);
+  if (replacement) {
+    replacement.focus({ preventScroll: true });
+    if (typeof start === "number" && typeof end === "number") replacement.setSelectionRange(start, end);
+  }
+  window.scrollTo(x, y);
 }
 
